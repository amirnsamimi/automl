  "application_invariants": [
    "All public listings require at least one image with role main and one payment option. Enforce in the publishing transaction; partial unique only ensures at most one main.",
    "Every car must reference an owner. Never send owner_id or the owners row in public API responses.",
    "Installment down payment must be less than or equal to the current car price; validate across rows in a transaction.",
    "Changing price must revalidate installment options.",
    "Known Gregorian model year cannot be translated to Jalali by simply subtracting 621. Store a declared Jalali production year from documentation; optionally add documented production_date separately.",
    "updated_at must be updated by the server on each change.",
    "Public read routes return available listings by default. Admin writes require role and record-level authorization.",
    "Store one canonical amount in toman, not rial, and convert million-toman URL bounds exactly by 1,000,000."
  ],
  "defaults": {
    "id": "database-generated UUID for real records; deterministic supplied UUIDs for mock import",
    "created_at": "database current timestamp",
    "updated_at": "database current timestamp on insertion; explicit update thereafter",
    "status": "available",
    "verified": false,
    "is_illustrative": false
  }
